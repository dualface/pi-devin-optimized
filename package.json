{
  "name": "pi-devin-local",
  "version": "0.2.0",
  "description": "Devin Local models in Pi — SWE-2, Opus 5, Fable 5, Sol and friends, with auth and the live model catalog coming from the local Devin CLI.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "devin",
    "devin-local",
    "cognition",
    "swe-2",
    "custom-provider"
  ],
  "author": "Kashyab Ambarani",
  "contributors": [
    "mizorewww"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizorewww/pi-devin.git"
  },
  "homepage": "https://github.com/mizorewww/pi-devin#readme",
  "bugs": {
    "url": "https://github.com/mizorewww/pi-devin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions/",
    "src/",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
